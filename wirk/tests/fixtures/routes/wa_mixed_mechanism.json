{
  "id": "wa-mixed-mechanism",
  "waypoints": [
    {
      "id": "outer",
      "kind": "Container",
      "declared_outputs": [
        {"name": "a.md", "required": true},
        {"name": "b.md", "required": true}
      ],
      "required_child_outcomes": [
        {"role": "helper", "required": true}
      ],
      "leaves": [
        {
          "id": "outer/act",
          "kind": "Actor",
          "intent": "write a.md by hand",
          "declared_outputs": [{"name": "a.md", "required": true}]
        },
        {
          "id": "outer/det",
          "kind": "Deterministic",
          "command": ["sh", "-c", "echo b > b.md"],
          "declared_outputs": [{"name": "b.md", "required": true}]
        }
      ]
    }
  ]
}
