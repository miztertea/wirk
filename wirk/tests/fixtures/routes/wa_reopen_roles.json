{
  "id": "wa-reopen-roles",
  "waypoints": [
    {
      "id": "top",
      "kind": "Container",
      "declared_outputs": [
        {"name": "a.md", "required": true},
        {"name": "b.md", "required": true},
        {"name": "t.md", "required": true}
      ],
      "required_child_outcomes": [
        {"role": "reviewer", "required": true}
      ],
      "leaves": [
        {
          "id": "top/outer",
          "kind": "Container",
          "declared_outputs": [
            {"name": "a.md", "required": true},
            {"name": "b.md", "required": true}
          ],
          "required_child_outcomes": [
            {"role": "helper", "required": true}
          ],
          "leaves": [
            {
              "id": "top/outer/a",
              "kind": "Container",
              "declared_outputs": [{"name": "b.md", "required": true}],
              "leaves": [
                {
                  "id": "top/outer/a/leaf",
                  "kind": "Deterministic",
                  "command": ["sh", "-c", "echo b > b.md"],
                  "declared_outputs": [{"name": "b.md", "required": true}]
                }
              ]
            },
            {
              "id": "top/outer/lead",
              "kind": "Deterministic",
              "command": ["sh", "-c", "echo a > a.md"],
              "declared_outputs": [{"name": "a.md", "required": true}]
            }
          ]
        },
        {
          "id": "top/tail",
          "kind": "Deterministic",
          "command": ["sh", "-c", "echo t > t.md"],
          "declared_outputs": [{"name": "t.md", "required": true}]
        }
      ]
    }
  ]
}
